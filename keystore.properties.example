# Copy this file to keystore.properties (already .gitignore'd — never commit the real one) and
# fill in your own release keystore's real values. Generate a keystore with:
#   keytool -genkey -v -keystore release.keystore -alias aura -keyalg RSA -keysize 2048 -validity 10000
#
# Back up release.keystore and these credentials somewhere safe outside this repository — losing
# them means losing the ability to publish updates to an already-published app under the same
# signing identity, permanently. See docs/PRODUCTION_RELEASE.md.

storeFile=/absolute/path/to/release.keystore
storePassword=changeme
keyAlias=aura
keyPassword=changeme
